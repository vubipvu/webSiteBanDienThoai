# Copy thành .env trên server (không commit secret thật)
NODE_ENV=production
ATM66_API_PORT=3001
ATM66_HOST=127.0.0.1
# Bắt buộc khi NODE_ENV=production — chuỗi dài ngẫu nhiên
ATM66_JWT_SECRET=thay-bang-chuoi-dai-ngau-nhien
# Origin frontend nếu API tách domain; cùng origin thì để trống / không set
# ATM66_CORS_ORIGIN=https://tenmien-cua-ban.com
# (Tuỳ chọn) ghi đè tài khoản admin khi seed/đồng bộ DB
# ATM66_ADMIN_USER=
# ATM66_ADMIN_PASS=

# --- Render / PaaS ---
# Render inject PORT — app ưu tiên process.env.PORT (không cần set local).
# Persistent disk (Starter+): mount /var/data rồi bật một trong các cách:
# ATM66_PERSIST_ROOT=/var/data
# hoặc tách riêng:
# ATM66_DATA_DIR=/var/data/data
# ATM66_UPLOADS_DIR=/var/data/uploads
