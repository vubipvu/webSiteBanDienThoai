# Copy thành .env trên server Node (Railway/Render/Fly/VPS) — không commit secret thật
# Vercel static-only: các biến dưới đây KHÔNG làm API/SQLite chạy trên Vercel.
NODE_ENV=production
ATM66_API_PORT=3001
ATM66_HOST=0.0.0.0
# Bắt buộc khi NODE_ENV=production — chuỗi dài ngẫu nhiên
ATM66_JWT_SECRET=thay-bang-chuoi-dai-ngau-nhien
# Origin frontend nếu API tách domain (vd. Vercel FE); cùng origin thì để trống / không set
# ATM66_CORS_ORIGIN=https://tenmien-cua-ban.vercel.app
# (Tuỳ chọn) ghi đè tài khoản admin khi seed/đồng bộ DB
# ATM66_ADMIN_USER=
# ATM66_ADMIN_PASS=
