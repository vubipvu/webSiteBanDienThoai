# Copy thành .env trên server (không commit secret thật)
NODE_ENV=production
ATM66_API_PORT=3001
ATM66_HOST=127.0.0.1
# Bắt buộc trừ khi NODE_ENV=development — chuỗi ≥32 ký tự, không dùng secret mặc định
ATM66_JWT_SECRET=thay-bang-chuoi-dai-ngau-nhien-toi-thieu-32
# Origin frontend nếu API tách domain; cùng origin thì để trống / không set
# ATM66_CORS_ORIGIN=https://tenmien-cua-ban.com
# Bắt buộc khi seed admin trên production/hosted
# ATM66_ADMIN_USER=
# ATM66_ADMIN_PASS=
# Chỉ bật nếu đứng sau reverse proxy tin cậy (rate-limit dùng req.ip)
# ATM66_TRUST_PROXY=1
